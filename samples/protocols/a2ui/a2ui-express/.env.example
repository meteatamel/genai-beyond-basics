# Copy to .env and configure EITHER Option 1 (Gemini API Key) OR Option 2 (Google Cloud / Vertex AI).
# If you have Application Default Credentials (`gcloud auth application-default login`),
# Vertex AI will also be detected automatically when no API key is set.

# Option 1: Gemini Developer API (Google AI Studio)
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Google Cloud Vertex AI (Application Default Credentials)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
